<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ProjectGuid>{1F2568C7-6FEB-4564-8E98-A0C514DDDCA3}</ProjectGuid>
    <MainSource>ConnectionRestartProbe.dpr</MainSource>
    <Config>Debug</Config>
    <Platform>Win64</Platform>
    <Base>True</Base>
    <TargetedPlatforms>3</TargetedPlatforms>
    <AppType>Console</AppType>
    <ProjectVersion>20.3</ProjectVersion>
    <DCC_Namespace>System;Winapi;Data;Xml</DCC_Namespace>
    <DCC_UnitAlias>Generics.Collections=System.Generics.Collections;Generics.Defaults=System.Generics.Defaults;$(DCC_UnitAlias)</DCC_UnitAlias>
    <DCC_UnitSearchPath>..\..\..\..\core;..\..\..\..\libraries\sphere10;..\..\..\..\libraries\simplebaselib4pascal;..\..\..\..\libraries\hashlib4pascal;..\..\..\..\libraries\cryptolib4pascal;..\..\..\..\libraries\synapse;..\..\..\..\libraries\pascalcoin;..\..\..\..\libraries\paszlib;..\..\..\..\libraries\abstractmem;..\..\..\..\libraries\regex</DCC_UnitSearchPath>
    <DCC_IncludePath>..\..\..\..\core;..\..\..\..\libraries\sphere10;..\..\..\..\libraries\generics.collections\inc</DCC_IncludePath>
    <DCC_DcuOutput>..\..\lib\connection-restart\Delphi\$(Platform)\$(Config)\dcu</DCC_DcuOutput>
    <DCC_ExeOutput>..\..\lib\connection-restart\Delphi\$(Platform)\$(Config)</DCC_ExeOutput>
    <DCC_DebugInformation>true</DCC_DebugInformation>
    <DCC_RangeChecking>true</DCC_RangeChecking>
    <DCC_IntegerOverflowCheck>true</DCC_IntegerOverflowCheck>
  </PropertyGroup>
  <ItemGroup>
    <DelphiCompile Include="$(MainSource)">
      <MainSource>MainSource</MainSource>
    </DelphiCompile>
    <DCCReference Include="UConnectionRestartChecks.pas" />
  </ItemGroup>
  <ProjectExtensions>
    <Borland.Personality>Delphi.Personality.12</Borland.Personality>
    <BorlandProject>
      <Delphi.Personality>
        <Source>
          <Source Name="MainSource">ConnectionRestartProbe.dpr</Source>
        </Source>
      </Delphi.Personality>
      <Platforms>
        <Platform value="Win32">True</Platform>
        <Platform value="Win64">True</Platform>
      </Platforms>
    </BorlandProject>
  </ProjectExtensions>
  <Import Project="$(BDS)\Bin\CodeGear.Delphi.Targets" />
</Project>