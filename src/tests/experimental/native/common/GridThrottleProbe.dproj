<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ProjectGuid>{21604B67-51B7-42C9-85F1-B085DFB9BB1C}</ProjectGuid>
    <MainSource>GridThrottleProbe.dpr</MainSource>
    <Config Condition="'$(Config)'==''">Debug</Config>
    <Platform Condition="'$(Platform)'==''">Win64</Platform>
    <Base>True</Base>
    <TargetedPlatforms>3</TargetedPlatforms>
    <AppType>Console</AppType>
    <FrameworkType>VCL</FrameworkType>
    <ProjectVersion>20.3</ProjectVersion>
    <DCC_Namespace>System;Winapi;Vcl;Vcl.Imaging;Data;Xml</DCC_Namespace>
    <DCC_Define>VISUALGRID_TEST_WORKER_START;$(DCC_Define)</DCC_Define>
    <DCC_UnitAlias>Generics.Collections=System.Generics.Collections;Generics.Defaults=System.Generics.Defaults;$(DCC_UnitAlias)</DCC_UnitAlias>
    <DCC_UnitSearchPath>..\..\framework;..\..\..\..\libraries\sphere10;$(DCC_UnitSearchPath)</DCC_UnitSearchPath>
    <DCC_IncludePath>..\..\..\..\libraries\sphere10;$(DCC_IncludePath)</DCC_IncludePath>
    <DCC_ResourcePath>..\..\lib\Delphi\$(Platform)\grid-throttle\$(Config)\res;..\..\..\..\libraries\sphere10;$(DCC_ResourcePath)</DCC_ResourcePath>
    <DCC_DcuOutput>..\..\lib\Delphi\$(Platform)\grid-throttle\$(Config)\obj</DCC_DcuOutput>
    <DCC_ExeOutput>..\..\lib\Delphi\$(Platform)\grid-throttle\$(Config)</DCC_ExeOutput>
    <BRCC_OutputDir>..\..\lib\Delphi\$(Platform)\grid-throttle\$(Config)\res</BRCC_OutputDir>
    <BRCC_IncludePath>..\..\..\..\libraries\sphere10;$(BRCC_IncludePath)</BRCC_IncludePath>
    <DCC_RangeChecking>true</DCC_RangeChecking>
    <DCC_IntegerOverflowCheck>true</DCC_IntegerOverflowCheck>
  </PropertyGroup>
  <ItemGroup>
    <RcCompile Include="..\..\..\..\libraries\sphere10\UVisualGrid.VCL.rc" />
    <DelphiCompile Include="$(MainSource)"><MainSource>MainSource</MainSource></DelphiCompile>
    <BuildConfiguration Include="Base"><Key>Base</Key></BuildConfiguration>
    <BuildConfiguration Include="Debug"><Key>Debug</Key><CfgParent>Base</CfgParent></BuildConfiguration>
    <BuildConfiguration Include="Release"><Key>Release</Key><CfgParent>Base</CfgParent></BuildConfiguration>
  </ItemGroup>
  <ProjectExtensions>
    <Borland.Personality>Delphi.Personality.12</Borland.Personality>
    <BorlandProject><Delphi.Personality><Source><Source Name="MainSource">GridThrottleProbe.dpr</Source></Source></Delphi.Personality>
      <Platforms><Platform value="Win32">True</Platform><Platform value="Win64">True</Platform></Platforms>
    </BorlandProject>
  </ProjectExtensions>
  <Import Project="$(BDS)\Bin\CodeGear.Delphi.Targets" />
</Project>
