<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ProjectGuid>{BA9798D8-AE57-4D60-95F9-141EC705A9D9}</ProjectGuid>
    <MainSource>BufferedAdoptionProbe.dpr</MainSource>
    <Config>Debug</Config>
    <Platform>Win64</Platform>
    <Base>True</Base>
    <TargetedPlatforms>3</TargetedPlatforms>
    <AppType>Application</AppType>
    <FrameworkType>VCL</FrameworkType>
    <ProjectVersion>20.3</ProjectVersion>
    <DCC_Namespace>System;Winapi;Vcl;Vcl.Imaging;Data;Xml</DCC_Namespace>
    <DCC_UnitAlias>Generics.Collections=System.Generics.Collections;Generics.Defaults=System.Generics.Defaults;$(DCC_UnitAlias)</DCC_UnitAlias>
    <DCC_UnitSearchPath>..\..\..\..\core;..\..\..\..\gui-experimental;..\..\..\..\gui-experimental\core.utils;..\..\..\..\gui-experimental\wizards\wallet;..\..\..\..\gui-experimental\wizards\operations;..\..\..\..\gui-classic;..\..\..\..\libraries\sphere10;..\..\..\..\libraries\simplebaselib4pascal;..\..\..\..\libraries\hashlib4pascal;..\..\..\..\libraries\cryptolib4pascal;..\..\..\..\libraries\synapse;..\..\..\..\libraries\pascalcoin;..\..\..\..\libraries\paszlib;..\..\..\..\libraries\abstractmem;..\..\..\..\libraries\regex</DCC_UnitSearchPath>
    <DCC_IncludePath>..\..\..\..\core;..\..\..\..\libraries\generics.collections\inc;..\..\..\..\libraries\sphere10</DCC_IncludePath>
    <DCC_UnitSearchPath>$(DCC_UnitSearchPath);..\..\..\..\libraries\gnugettext</DCC_UnitSearchPath>
    <DCC_ResourcePath>..\..\lib\buffered-adoption\Delphi\$(Platform)\$(Config)\res;..\..\..\..;..\..\..\..\gui-experimental;..\..\..\..\gui-classic;..\..\..\..\gui-experimental\wizards\wallet;..\..\..\..\gui-experimental\wizards\operations</DCC_ResourcePath>
    <DCC_DcuOutput>..\..\lib\buffered-adoption\Delphi\$(Platform)\$(Config)\dcu</DCC_DcuOutput>
    <DCC_ExeOutput>..\..\lib\buffered-adoption\Delphi\$(Platform)\$(Config)</DCC_ExeOutput>
    <BRCC_OutputDir>..\..\lib\buffered-adoption\Delphi\$(Platform)\$(Config)\res</BRCC_OutputDir>
    <DCC_DebugInformation>true</DCC_DebugInformation>
    <DCC_RangeChecking>true</DCC_RangeChecking>
    <DCC_IntegerOverflowCheck>true</DCC_IntegerOverflowCheck>
  </PropertyGroup>
  <ItemGroup>
    <DelphiCompile Include="$(MainSource)">
      <MainSource>MainSource</MainSource>
    </DelphiCompile>
    <DCCReference Include="UBufferedAdoptionChecks.pas" />
  </ItemGroup>
  <ProjectExtensions>
    <Borland.Personality>Delphi.Personality.12</Borland.Personality>
    <BorlandProject>
      <Delphi.Personality>
        <Source>
          <Source Name="MainSource">BufferedAdoptionProbe.dpr</Source>
        </Source>
      </Delphi.Personality>
      <Platforms>
        <Platform value="Win32">True</Platform>
        <Platform value="Win64">True</Platform>
      </Platforms>
    </BorlandProject>
  </ProjectExtensions>
  <Import Project="$(BDS)\Bin\CodeGear.Delphi.Targets" />
</Project>