  </PropertyGroup>
  <ItemGroup>
    <DelphiCompile Include="$(MainSource)">
      <MainSource>MainSource</MainSource>
    </DelphiCompile>
    <DCCReference Include="UStoredHistoryChecks.pas" />
  </ItemGroup>
  <ProjectExtensions>
